{
  "name": "tarsas-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node --env-file-if-exists=.env server/server.js",
    "test:atomic": "node --test tests/atomicTransactions.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore \"node --test tests/firestore.rules.test.mjs\"",
    "test:security": "node --test tests/securityControls.test.mjs",
    "test:adapter": "node --test tests/firestoreAdapter.test.mjs",
    "test:explorer": "node --test tests/docExplorer.test.mjs",
    "test:team": "node --test tests/teamPermissions.test.mjs",
    "migrate:emulator": "node scripts/migrateRtdbToFirestore.mjs --target=emulator",
    "verify:emulator": "node scripts/verifyMigrationParity.mjs --target=emulator"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "lucide-react": "^0.354.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "read-excel-file": "^9.3.19",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^8.3.8"
  }
}
