# ==============================================================================
# TarsasApp - Környezeti Változók Sablon (.env.example)
# Másold le .env néven és töltsd ki az éles/teszt hitelesítő adatokkal!
# ==============================================================================

# Backend szerver beállítások
PORT=5001
NODE_ENV=development

# OTP Bank Corporate / Open Banking API beállítások
OTP_API_BASE_URL=https://sandbox.api.otpbank.hu
OTP_AUTH_URL=https://sandbox.api.otpbank.hu/auth/oauth2/token
OTP_CLIENT_ID=your_otp_client_id_here
OTP_CLIENT_SECRET=your_otp_client_secret_here

# mTLS Tanúsítványok és Privát Kulcs elérési útjai
OTP_CERT_PATH=./server/certs/otp_cert.pem
OTP_KEY_PATH=./server/certs/otp_private.key
OTP_KEY_PASSPHRASE=

# Belső API védelem (opcionális API kulcs a backend hívásokhoz)
INTERNAL_API_SECRET=dev_internal_secret_change_in_production
